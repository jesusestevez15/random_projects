     '\n\n Vector de distorsión de cámara derecha (dstR): \n\n', str(distR),
     '\n\n Matriz Q: \n\n', str(Q),
     '\n\n Error de calibración cámara izquierda (mean_errorL): \n\n', str(mean_errorL / len(objpoints)),
     '\n\n Error de calibración cámara derecha (mean_errorR): \n\n', str(mean_errorR / len(objpoints)),
     '\n\n Error total de la calibración estéreo (rms_error): \n\n', str(rms_error)
     ]

file = open('datos_calibracion.txt', 'w')
file.write('Datos de la calibración:')
